import random

INTERVALO_QUEDA = 500  


FORMAS = [
    ([[1, 1, 1, 1]], (0, 240, 240)),            # I
    ([[1, 1], [1, 1]], (240, 240, 0)),          # O
    ([[0, 1, 0], [1, 1, 1]], (160, 0, 240)),    # T
    ([[1, 0], [1, 0], [1, 1]], (240, 160, 0)),  # L
    ([[0, 1, 1], [1, 1, 0]], (0, 240, 0)),      # S
]


def nova_peca(colunas):
    forma, cor = random.choice(FORMAS)
    return {
        "forma": forma,
        "cor": cor,
        "x": colunas // 2 - len(forma[0]) // 2,  
        "y": 0,                                   
    }


def colide(matriz, forma, px, py):
   
    linhas = len(matriz)
    colunas = len(matriz[0])
    for l, linha in enumerate(forma):
        for c, valor in enumerate(linha):
            if valor:
                x = px + c
                y = py + l
                if x < 0 or x >= colunas or y >= linhas:
                    return True
                if y >= 0 and matriz[y][x] != 0:
                    return True
    return False


def fixar_peca(matriz, peca):
    
    for l, linha in enumerate(peca["forma"]):
        for c, valor in enumerate(linha):
            if valor:
                matriz[peca["y"] + l][peca["x"] + c] = peca["cor"]


def mover_horizontal(matriz, peca, direcao):
    
    if not colide(matriz, peca["forma"], peca["x"] + direcao, peca["y"]):
        peca["x"] += direcao


def aplicar_gravidade(matriz, peca):
    
    if not colide(matriz, peca["forma"], peca["x"], peca["y"] + 1):
        peca["y"] += 1
        return peca

    fixar_peca(matriz, peca)
    return nova_peca(len(matriz[0]))
