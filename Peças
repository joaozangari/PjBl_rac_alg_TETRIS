import random
# 0 = vazio, number 1-5 = cores

PECAS_MATRIZ = {
    'I': [
        [0, 1, 0, 0],
        [0, 1, 0, 0],
        [0, 1, 0, 0],
        [0, 1, 0, 0]
    ],
    'O': [
        [2, 2],
        [2, 2]
    ],
    'T': [
        [3, 3, 3],
        [0, 3, 0],
        [0, 3, 0]
    ],
    'L': [
        [4, 0, 0],
        [4, 0, 0],
        [4, 4, 0]
    ],
    'J': [
        [0, 0, 5],
        [0, 0, 5],
        [0, 5, 5]
    ]
}

class Peca:
    def __init__(self, coluna_inicial=3, linha_inicial=0):
        self.tipo = random.choice(list(PECAS_MATRIZ.keys()))
        self.matriz = PECAS_MATRIZ[self.tipo]

        self.x = coluna_inicial
        self.y = linha_inicial

def gerar_peca():
    return Peca(coluna_inicial=3, linha_inicial=0)